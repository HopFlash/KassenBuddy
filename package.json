{
	"name": "kassenbuddy",
	"private": true,
	"version": "1.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm run build:web",
		"build:web": "vite build",
		"android:init": "npx cap add android",
		"android:open": "npx cap open android",
		"android:sync": "npx cap sync android",
		"build:android": "pnpm run build:web && pnpm run android:sync",
		"android:apk:linux": "cd android && ./gradlew assembleDebug",
		"android:apk:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\android-gradle-windows.ps1 -Task assembleDebug",
		"android:apk-release:linux": "cd android && ./gradlew assembleRelease",
		"android:apk-release:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\android-gradle-windows.ps1 -Task assembleRelease",
		"android:aab:linux": "cd android && ./gradlew bundleRelease",
		"android:aab:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\android-gradle-windows.ps1 -Task bundleRelease",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"watch": "vite build --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.61.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^25.9.1",
		"@vite-pwa/sveltekit": "^1.1.0",
		"svelte": "^5.55.9",
		"svelte-check": "^4.4.8",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.14",
		"workbox-window": "^7.4.1"
	},
	"dependencies": {
		"@capacitor/android": "^7.4.3",
		"@capacitor/cli": "^7.4.3",
		"@capacitor/core": "^7.4.3",
		"idb": "^8.0.3",
		"pnpm": "11.5.2",
		"xlsx": "^0.18.5"
	}
}
